# Copy this file to .env.production and replace every change_me value.
TZ=Asia/Shanghai
APEX_HTTP_PORT=8088
JAVA_TOOL_OPTIONS=-Xms256m -Xmx1024m

# Existing MySQL container and its Docker network.
MYSQL_HOST=mysql
MYSQL_DOCKER_NETWORK=mysql_default
MYSQL_PORT=3306
MYSQL_DATABASE=apex
MYSQL_USER=apex_app
MYSQL_PASSWORD=change_me
REDIS_PASSWORD=change_me

APEX_LOCAL_USERNAME=admin
APEX_LOCAL_PASSWORD=change_me
APEX_JWT_SECRET=change_me_with_a_long_random_value

APEX_AI_ENABLED=false
APEX_AI_BASE_URL=https://api.moonshot.cn/v1
APEX_AI_API_KEY=
APEX_AI_MODEL=kimi-k2.6

# OpenClaw read-only Bot API. Keep proactive WeChat delivery disabled until a
# concrete channel and recipient ID have been verified.
APEX_BOT_ENABLED=false
APEX_BOT_CLIENT_KEY=
APEX_BOT_CLIENT_SECRET=
APEX_BOT_TIMESTAMP_TOLERANCE_SECONDS=300
APEX_BOT_NOTIFICATION_COOLDOWN_SECONDS=1800
APEX_BOT_MOVER_THRESHOLD=5
APEX_BOT_WATCHLIST_GROUP=我的自选
APEX_BOT_WECLAW_ENABLED=false
APEX_BOT_WECLAW_BASE_URL=
APEX_BOT_WECLAW_RECIPIENT=
APEX_BOT_WECLAW_API_TOKEN=
APEX_BOT_WECLAW_TIMEOUT_MS=5000
