spring:
  datasource:
    url: jdbc:p6spy:mysql://127.0.0.1:3306/apex?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=GMT%2B8&autoReconnect=true&rewriteBatchedStatements=true&allowPublicKeyRetrieval=true
    username: root
    password: your_password
    driver-class-name: com.p6spy.engine.spy.P6SpyDriver

apex:
  mx-output-dir: ${user.dir}/../../.mx_output
