spring:
  datasource:
    url: jdbc:p6spy:mysql://127.0.0.1:3306/apex?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_0900_ai_ci&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=GMT%2B8&autoReconnect=true&rewriteBatchedStatements=true&allowPublicKeyRetrieval=true
    username: root
    password: your_password
    driver-class-name: com.p6spy.engine.spy.P6SpyDriver

apex:
  mx-output-dir: ${user.dir}/../../.mx_output
  # Kimi / Moonshot（勿提交真实 Key）
  ai:
    enabled: true
    base-url: https://api.moonshot.cn/v1
    api-key: your_moonshot_api_key
    model: kimi-k2.6
