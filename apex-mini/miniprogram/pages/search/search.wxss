.search-bar { display:flex; gap:12rpx; }.search-bar input { box-sizing:border-box; height:76rpx; flex:1; min-width:0; padding:0 20rpx; border:1rpx solid #cbd5e1; border-radius:6rpx; color:#18212f; background:#fff; font-size:26rpx; }.search-bar button { flex:0 0 auto; min-width:120rpx; margin:0; padding:0 18rpx; height:76rpx; border-radius:6rpx; color:#fff; background:#1669c9; font-size:24rpx; font-weight:600; line-height:76rpx; }.results { margin-top:18rpx; overflow:hidden; }.result { display:flex; align-items:center; justify-content:space-between; gap:16rpx; min-height:90rpx; padding:22rpx 24rpx; border-bottom:1rpx solid #e5eaf1; }.result:last-child { border:0; }.result-hover { background:#f2f7fd; }.name,.meta,.result-price text { display:block; }.name { color:#18212f; font-size:28rpx; font-weight:700; }.meta { margin-top:7rpx; color:#64748b; font-size:21rpx; }.result-price { flex:0 0 auto; text-align:right; }.price { color:#18212f; font-size:27rpx; font-variant-numeric:tabular-nums; }.result-price text:last-child { margin-top:5rpx; color:#1669c9; font-size:20rpx; }.state-detail { display:block; margin-top:8rpx; color:#8793a5; font-size:21rpx; }.search-hint { color:#8793a5; }
