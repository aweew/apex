<view class="apex-page"><view class="apex-page-head"><view><text class="apex-eyebrow">SECURITY SEARCH</text><text class="apex-title">搜索股票</text><text class="apex-subtitle">代码、简称或市场标识</text></view></view><view class="search-bar"><input value="{{keyword}}" placeholder="例如：600519 或 贵州茅台" confirm-type="search" focus bindinput="onInput" bindconfirm="search"/><button bindtap="search">搜索</button></view><view wx:if="{{loading}}" class="apex-state">正在查找匹配股票...</view><view wx:elif="{{stocks.length}}" class="results apex-panel"><view wx:for="{{stocks}}" wx:key="code" class="result" bindtap="openStock" data-code="{{item.code}}" hover-class="result-hover"><view><text class="name">{{item.name}}</text><text class="meta">{{item.code}} {{item.market || ''}}</text></view><view class="result-price"><text class="price">{{numberText(item.latestPrice)}}</text><text>查看</text></view></view></view><view wx:elif="{{searched}}" class="apex-state">没有找到“{{keyword}}”<text class="state-detail">请检查代码或换用股票简称</text></view><view wx:else class="apex-state search-hint">输入后按键盘搜索，或点击右侧按钮</view></view>
