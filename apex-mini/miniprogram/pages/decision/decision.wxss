.refresh-button { flex:0 0 auto; height:60rpx; margin:2rpx 0 0; padding:0 18rpx; border:1rpx solid #cbd5e1; border-radius:6rpx; color:#1669c9; background:#fff; font-size:22rpx; line-height:58rpx; }
.count-panel,.risk-panel,.list-panel { box-sizing:border-box; width:100%; margin-bottom:18rpx; border:1rpx solid #dce3ed; border-radius:8rpx; background:#fff; box-shadow:0 2rpx 8rpx rgba(15,23,42,.06); }
.count-panel { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); padding:12rpx 0; }.count-panel view { min-width:0; padding:13rpx 6rpx; border-left:1rpx solid #e5eaf1; text-align:center; }.count-panel view:first-child { border-left:0; }.count-panel .count-cell { transition: background .15s ease; }.count-panel .selected { background:#f2f7fd; }.count-panel text,.count-panel b { display:block; }.count-panel text { color:#8793a5; font-size:19rpx; }.count-panel b { margin-top:7rpx; color:#18212f; font-size:34rpx; }.count-panel .buy { color:#e5484d; }.count-panel .sell { color:#23855a; }.count-panel .execute { color:#1669c9; }
.risk-panel { display:flex; justify-content:space-between; gap:16rpx; padding:20rpx 22rpx; border-left:5rpx solid #f0a020; }.risk-panel > view { min-width:0; }.risk-panel text { display:block; }.risk-panel text:first-child { color:#18212f; font-size:24rpx; font-weight:700; }.risk-panel text:last-child { margin-top:7rpx; color:#64748b; font-size:21rpx; line-height:1.45; }.risk-mark { flex:0 0 auto; color:#b76b00; font-size:18rpx; font-weight:700; letter-spacing:1rpx; }
.list-panel { overflow:hidden; }.tab-row { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); border-bottom:1rpx solid #e5eaf1; }.tab { padding:20rpx 4rpx 16rpx; color:#64748b; text-align:center; font-size:21rpx; }.tab text { margin-left:5rpx; font-size:18rpx; }.tab.active { position:relative; color:#1669c9; font-weight:700; }.tab.active::after { position:absolute; right:20rpx; bottom:-1rpx; left:20rpx; height:4rpx; background:#1669c9; content:''; }
.decision-item { box-sizing:border-box; width:100%; padding:22rpx 24rpx; border-bottom:1rpx solid #e5eaf1; background:#fff; }.decision-item-hover { background:#f8fafc; }.item-top { display:flex; align-items:flex-start; justify-content:space-between; gap:16rpx; }.stock-name { display:flex; align-items:baseline; gap:10rpx; min-width:0; }.stock-name b { flex:0 0 auto; color:#18212f; font-size:27rpx; }.stock-name text { overflow:hidden; color:#344154; font-size:26rpx; font-weight:650; text-overflow:ellipsis; white-space:nowrap; }.item-right { flex:0 0 auto; text-align:right; }.item-right text,.item-right b { display:block; }.item-right text { padding:4rpx 7rpx; border-radius:4rpx; font-size:18rpx; }.item-right b { margin-top:6rpx; color:#1669c9; font-size:20rpx; }.action-buy { color:#b42318; background:#ffebe9; }.action-sell { color:#137333; background:#e8f5e9; }.action-hold { color:#5b6472; background:#eff2f5; }.action-watch { color:#9a6700; background:#fff5d7; }
.metric-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10rpx; margin-top:16rpx; }.metric-grid view { min-width:0; padding:9rpx 10rpx; background:#f7f9fc; }.metric-grid text,.metric-grid b { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.metric-grid text { color:#8793a5; font-size:18rpx; }.metric-grid b { margin-top:4rpx; color:#344154; font-size:20rpx; }.sell-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
.tag-row { display:flex; flex-wrap:wrap; gap:7rpx; margin-top:13rpx; }.tag-row text { padding:4rpx 8rpx; border-radius:4rpx; font-size:18rpx; }.tag-positive { color:#137333; background:#e8f5e9; }.tag-negative { color:#b42318; background:#ffebe9; }.tag-gate { color:#1669c9; background:#edf5ff; }.tag-mainline { color:#9a6700; background:#fff5d7; }
.reason { display:block; margin-top:13rpx; color:#64748b; font-size:21rpx; line-height:1.45; overflow-wrap:anywhere; word-break:break-all; }.exit-rule { display:flex; align-items:flex-start; gap:10rpx; margin-top:14rpx; padding:11rpx 12rpx; border-left:4rpx solid rgba(240,160,32,.55); background:#fffaf1; color:#344154; font-size:21rpx; line-height:1.45; }.exit-rule text:first-child { flex:0 0 auto; color:#9a6700; }.exit-rule text:last-child { min-width:0; overflow-wrap:anywhere; word-break:break-all; }.hold-reason { margin-top:12rpx; }
.empty-text { display:block; padding:50rpx 20rpx; color:#8793a5; text-align:center; font-size:22rpx; }
