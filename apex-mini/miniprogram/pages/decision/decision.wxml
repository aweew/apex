<scroll-view class="apex-page" scroll-y enable-back-to-top>
  <view class="apex-page-head"><view><text class="apex-eyebrow">DECISION · PRIORITY</text><text class="apex-title">今日清单</text><text class="apex-subtitle">{{decision.actionDate || '待生成'}} · 股票池 {{decision.universeCount || '--'}}</text></view><button class="refresh-button" bindtap="loadPage">刷新</button></view>
  <view wx:if="{{error}}" class="apex-state apex-error"><text>{{error}}</text><button class="apex-retry" bindtap="loadPage">重新加载</button></view>
  <block wx:elif="{{!loading}}">
    <view class="count-panel"><view class="count-cell {{activeTab === 'buy' ? 'selected' : ''}}" data-tab="buy" bindtap="switchTab"><text>买入</text><b class="buy">{{decision.buyCount || buyItems.length}}</b></view><view class="count-cell {{activeTab === 'sell' ? 'selected' : ''}}" data-tab="sell" bindtap="switchTab"><text>卖出</text><b class="sell">{{decision.sellCount || sellItems.length}}</b></view><view class="count-cell {{activeTab === 'hold' ? 'selected' : ''}}" data-tab="hold" bindtap="switchTab"><text>持有</text><b>{{decision.holdCount || holdItems.length}}</b></view><view><text>可执行</text><b class="execute">{{decision.executableCount || 0}}</b></view></view>
    <view class="risk-panel"><view><text>风险提示</text><text>{{decision.riskNote || '暂无风险提示'}}</text></view><text class="risk-mark">RISK</text></view>
    <view class="list-panel"><view class="tab-row"><view class="tab {{activeTab === 'buy' ? 'active' : ''}}" data-tab="buy" bindtap="switchTab">建议买入 <text>{{buyItems.length}}</text></view><view class="tab {{activeTab === 'sell' ? 'active' : ''}}" data-tab="sell" bindtap="switchTab">建议卖出 <text>{{sellItems.length}}</text></view><view class="tab {{activeTab === 'hold' ? 'active' : ''}}" data-tab="hold" bindtap="switchTab">继续持有 <text>{{holdItems.length}}</text></view></view>
      <view wx:if="{{activeTab === 'buy'}}"><view wx:for="{{buyItems}}" wx:key="code" class="decision-item" data-code="{{item.code}}" bindtap="openStock" hover-class="decision-item-hover"><view class="item-top"><view class="stock-name"><b>{{item.code}}</b><text>{{item.name}}</text></view><view class="item-right"><text class="{{item.actionClass}}">{{item.actionText}}</text><b>评分 {{item.scoreText}}</b></view></view><view class="metric-grid"><view><text>策略</text><b>{{item.strategyText}}</b></view><view><text>估值</text><b>{{item.valuationText}}</b></view><view><text>仓位</text><b>{{item.weightText}}</b></view></view><view wx:if="{{item.executableHint || item.entryText || item.linkHint || item.mainlineMatch}}" class="tag-row"><text wx:if="{{item.executableHint}}" class="tag-positive">可执行</text><text wx:if="{{item.entryText}}" class="tag-gate">门禁{{item.entryText}}</text><text wx:if="{{item.linkHint}}" class="{{item.linkClass}}">{{item.linkHint}}</text><text wx:if="{{item.mainlineMatch}}" class="tag-mainline">主线 · {{item.mainlineName || '匹配'}}</text></view><text class="reason">{{item.detailText}}</text></view><text wx:if="{{!buyItems.length}}" class="empty-text">暂无买入机会</text></view>
      <view wx:if="{{activeTab === 'sell'}}"><view wx:for="{{sellItems}}" wx:key="code" class="decision-item" data-code="{{item.code}}" bindtap="openStock" hover-class="decision-item-hover"><view class="item-top"><view class="stock-name"><b>{{item.code}}</b><text>{{item.name}}</text></view><view class="item-right"><text class="{{item.actionClass}}">{{item.actionText}}</text><b>评分 {{item.scoreText}}</b></view></view><view class="metric-grid sell-grid"><view><text>策略</text><b>{{item.strategyText}}</b></view><view><text>估值</text><b>{{item.valuationText}}</b></view></view><view class="exit-rule"><text>触发</text><text>{{item.detailText}}</text></view></view><text wx:if="{{!sellItems.length}}" class="empty-text">持仓暂无卖出建议</text></view>
      <view wx:if="{{activeTab === 'hold'}}"><view wx:for="{{holdItems}}" wx:key="code" class="decision-item" data-code="{{item.code}}" bindtap="openStock" hover-class="decision-item-hover"><view class="item-top"><view class="stock-name"><b>{{item.code}}</b><text>{{item.name}}</text></view><view class="item-right"><text class="{{item.actionClass}}">{{item.actionText}}</text><b>评分 {{item.scoreText}}</b></view></view><text class="reason hold-reason">{{item.detailText}}</text></view><text wx:if="{{!holdItems.length}}" class="empty-text">持仓为空，或均已有买卖建议</text></view>
    </view>
  </block>
  <view wx:else class="apex-state">正在生成优先级清单...</view>
</scroll-view>
