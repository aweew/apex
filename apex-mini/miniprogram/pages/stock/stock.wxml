<scroll-view class="apex-page" scroll-y enable-back-to-top><view wx:if="{{loading}}" class="apex-state">正在载入个股研究数据...</view><view wx:elif="{{error}}" class="apex-state apex-error"><text>{{error}}</text><button class="apex-retry" bindtap="reloadStock">重新加载</button></view><block wx:else><view class="stock-head"><view><text class="apex-eyebrow">SECURITY · DETAIL</text><text class="apex-title stock-title">{{detail.basic.name || detail.basic.code}}</text><text class="apex-subtitle">{{detail.basic.code}} {{detail.basic.market || ''}} · {{detail.basic.industry || '行业信息待补充'}}</text></view><button class="search-button" bindtap="openSearch">搜索</button></view><view class="quote"><view class="quote-kicker"><text>最新价</text><text class="{{changeClass(detail.basic.pctChg)}}">{{percentText(detail.basic.pctChg)}}</text></view><view class="price-row"><text class="price">{{numberText(detail.basic.latestPrice)}}</text></view><text class="quote-caption">行情按最新可用交易日展示</text></view><view class="section"><text class="title">近八个交易日收盘价</text><view class="bar-chart"><view wx:for="{{chartBars}}" wx:key="tradeDate" class="bar-wrap"><view class="bar" style="height: {{item.height}}rpx"></view><text>{{numberText(item.close)}}</text></view></view></view><view class="section metrics"><view><text>市盈率 TTM</text><b>{{numberText(detail.basic.peTtm)}}</b></view><view><text>市净率</text><b>{{numberText(detail.basic.pb)}}</b></view><view><text>量比</text><b>{{numberText(detail.volumeRatio)}}</b></view><view><text>20日相对强弱</text><b class="{{changeClass(detail.rs20VsHs300)}}">{{percentText(detail.rs20VsHs300)}}</b></view></view><view class="note"><text>{{detail.note || '行情与历史数据仅供研究参考。'}}</text></view><text class="disclaimer">本页面不构成买卖建议。</text></block></scroll-view>
