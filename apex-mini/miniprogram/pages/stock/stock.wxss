.stock-head { display:flex; align-items:flex-start; justify-content:space-between; gap:18rpx; margin:0 4rpx 24rpx; }.stock-title { max-width:520rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.search-button { flex:0 0 auto; height:60rpx; margin:2rpx 0 0; padding:0 18rpx; border:1rpx solid #cbd5e1; border-radius:6rpx; color:#1669c9; background:#fff; font-size:22rpx; line-height:58rpx; }.quote { padding:25rpx 24rpx; border:1rpx solid #dce3ed; border-radius:8rpx; background:#fff; box-shadow:0 2rpx 8rpx rgba(15,23,42,.06); }.quote-kicker { display:flex; align-items:center; justify-content:space-between; color:#8793a5; font-size:21rpx; }.quote-kicker text:last-child { font-size:25rpx; font-weight:700; font-variant-numeric:tabular-nums; }.price-row { display:flex; align-items:baseline; margin:16rpx 0 2rpx; }.price { color:#18212f; font-size:60rpx; font-weight:700; font-variant-numeric:tabular-nums; }.quote-caption { display:block; margin-top:8rpx; color:#8793a5; font-size:20rpx; }.section { margin:18rpx 0; padding:22rpx; border:1rpx solid #dce3ed; border-radius:8rpx; background:#fff; box-shadow:0 2rpx 8rpx rgba(15,23,42,.06); }.title { color:#18212f; font-size:26rpx; font-weight:700; }.bar-chart { display:flex; align-items:flex-end; justify-content:space-between; gap:7rpx; height:210rpx; margin-top:22rpx; }.bar-wrap { display:flex; flex:1; align-items:center; justify-content:flex-end; flex-direction:column; gap:8rpx; height:100%; overflow:hidden; color:#8793a5; font-size:18rpx; }.bar { width:100%; max-height:165rpx; border-radius:4rpx 4rpx 0 0; background:#1669c9; }.metrics { display:grid; grid-template-columns:1fr 1fr; padding:0; overflow:hidden; }.metrics view { display:flex; flex-direction:column; gap:10rpx; padding:23rpx; border-bottom:1rpx solid #e5eaf1; color:#8793a5; font-size:20rpx; }.metrics view:nth-child(odd) { border-right:1rpx solid #e5eaf1; }.metrics b { color:#18212f; font-size:29rpx; font-variant-numeric:tabular-nums; }.metrics b.up { color:#e5484d; }.metrics b.down { color:#23855a; }.note { margin:18rpx 0; padding:22rpx; border:1rpx solid #dce3ed; border-left:5rpx solid #1669c9; border-radius:8rpx; color:#64748b; background:#fff; box-shadow:0 2rpx 8rpx rgba(15,23,42,.06); font-size:22rpx; line-height:1.6; }.disclaimer { display:block; margin:30rpx 0; color:#8793a5; text-align:center; font-size:19rpx; }
