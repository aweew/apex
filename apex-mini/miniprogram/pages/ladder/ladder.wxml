<scroll-view class="apex-page" scroll-y enable-back-to-top>
  <view class="apex-page-head"><view><text class="apex-eyebrow">LIMIT-UP LADDER</text><text class="apex-title">连板天梯</text><text class="apex-subtitle">{{ladder.tradeDate || '最近交易日'}} · 高度与晋级观察</text></view><button class="refresh-button" bindtap="loadPage">刷新</button></view>
  <view wx:if="{{error}}" class="apex-state apex-error"><text>{{error}}</text><button class="apex-retry" bindtap="loadPage">重新加载</button></view><block wx:elif="{{!loading}}"><view class="ladder-summary"><view><text>涨停总数</text><b>{{ladder.totalCount || 0}}</b></view><view><text>最高连板</text><b>{{ladder.maxLianban || 0}}</b></view></view><view wx:for="{{ladder.tiers}}" wx:key="title" class="tier"><view class="tier-head"><view><b>{{item.title}}</b><text>{{item.count || 0}} 家</text></view><text>{{item.promoteLabel || '连板观察'}}</text></view><view class="stocks"><view wx:for="{{item.stocks}}" wx:for-item="stock" wx:key="code" class="stock-chip" data-code="{{stock.code}}" bindtap="openStock" hover-class="stock-chip-hover"><text>{{stock.name}}</text><text>{{stock.code}}</text></view></view></view><view wx:if="{{!ladder.tiers.length}}" class="apex-state">最近交易日暂无连板数据</view></block><view wx:else class="apex-state">正在整理连板高度...</view>
</scroll-view>
