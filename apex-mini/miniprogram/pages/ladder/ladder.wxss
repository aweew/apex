.refresh-button { flex:0 0 auto; height:60rpx; margin:2rpx 0 0; padding:0 18rpx; border:1rpx solid #cbd5e1; border-radius:6rpx; color:#1669c9; background:#fff; font-size:22rpx; line-height:58rpx; }
.ladder-summary,.tier { box-sizing:border-box; width:100%; margin-bottom:18rpx; border:1rpx solid #dce3ed; border-radius:8rpx; background:#fff; box-shadow:0 2rpx 8rpx rgba(15,23,42,.06); }.ladder-summary { display:grid; grid-template-columns:1fr 1fr; }.ladder-summary view { padding:21rpx; border-left:1rpx solid #e5eaf1; }.ladder-summary view:first-child { border:0; }.ladder-summary text,.ladder-summary b { display:block; }.ladder-summary text { color:#8793a5; font-size:20rpx; }.ladder-summary b { margin-top:7rpx; color:#e5484d; font-size:39rpx; }.tier { padding:22rpx; }.tier-head { display:flex; align-items:center; justify-content:space-between; gap:14rpx; }.tier-head view b,.tier-head view text { display:block; }.tier-head b { color:#18212f; font-size:28rpx; }.tier-head view text { margin-top:5rpx; color:#8793a5; font-size:20rpx; }.tier-head > text { color:#b76b00; font-size:19rpx; }.stocks { display:flex; flex-wrap:wrap; gap:10rpx; margin-top:18rpx; padding-top:16rpx; border-top:1rpx solid #e5eaf1; }.stock-chip { display:flex; align-items:baseline; gap:7rpx; max-width:100%; padding:10rpx 12rpx; border:1rpx solid #e5eaf1; border-radius:6rpx; background:#f8fafc; }.stock-chip text:first-child { overflow:hidden; color:#344154; font-size:22rpx; text-overflow:ellipsis; white-space:nowrap; }.stock-chip text:last-child { flex:0 0 auto; color:#8793a5; font-size:19rpx; }.stock-chip-hover { background:#edf5ff; }
