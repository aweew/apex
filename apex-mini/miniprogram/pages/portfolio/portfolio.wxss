.refresh-button { flex: 0 0 auto; height: 60rpx; margin: 2rpx 0 0; padding: 0 18rpx; border: 1rpx solid #cbd5e1; border-radius: 6rpx; color: #1669c9; background: #fff; font-size: 22rpx; line-height: 58rpx; }
.portfolio-list { overflow: hidden; }.portfolio-card { display:flex; align-items:center; justify-content:space-between; gap:18rpx; min-height: 104rpx; padding:24rpx; border-bottom:1rpx solid #e5eaf1; }.portfolio-card:last-child { border-bottom:0; }.portfolio-card-hover { background: #f2f7fd; }.portfolio-main { min-width:0; }.portfolio-name,.portfolio-meta,.equity text,.equity b { display:block; }.portfolio-name { overflow:hidden; color:#18212f; font-size:29rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }.portfolio-meta { margin-top:8rpx; overflow:hidden; color:#64748b; font-size:21rpx; text-overflow:ellipsis; white-space:nowrap; }.equity { flex:0 0 auto; text-align:right; font-variant-numeric:tabular-nums; }.equity-label { color:#8793a5; font-size:19rpx; }.equity b { margin-top:4rpx; color:#18212f; font-size:29rpx; }.equity text:last-child { margin-top:6rpx; font-size:21rpx; }
